# Copy to .env and fill in. Nothing in this file is a real secret as shipped.

# --- Mode ---
# "local": no auth, BigQuery via your own `gcloud auth application-default
#   login` credentials. Works today with zero Artiva inputs.
# "okta": real mode -- verifies Okta-issued tokens and performs the WIF
#   exchange per request. Needs every value below filled in.
AUTH_MODE=local

# --- Okta (Implementation Plan Phase 1 "Need from Artiva") ---
OKTA_ISSUER=
OKTA_CLIENT_ID=
OKTA_AUDIENCE=
OKTA_GROUPS_CLAIM=groups

# --- Workforce Identity Federation (Implementation Plan Phase 1.6) ---
GCP_WORKFORCE_POOL_ID=
GCP_WORKFORCE_PROVIDER_ID=
GCP_BILLING_PROJECT=

# --- BigQuery ---
BQ_PROJECT_ID=
BQ_ROW_LIMIT=500

# --- Server ---
# GATEWAY_HOST/PORT is what the process binds to (0.0.0.0:8080 works locally
# and on Cloud Run, which also injects its own PORT automatically).
# PUBLIC_URL is what the outside world reaches this at -- only matters once
# AUTH_MODE=okta; set it to the real Cloud Run URL once deployed.
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
PUBLIC_URL=http://127.0.0.1:8080
