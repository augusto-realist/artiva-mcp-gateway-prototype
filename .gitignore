.venv/
__pycache__/
*.pyc
.env

# Terraform -- state can contain sensitive values and must never be committed
# (gcp-foundation-artiva commits its tfstate; deliberately not repeating that here).
# .terraform.lock.hcl is NOT ignored -- that one should be committed, it just pins provider versions.
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.backup
# `terraform state mv`/`state rm` write their own timestamped backups
# (terraform.tfstate.<unix-timestamp>.backup) that the pattern above doesn't
# match -- found missing during the Fabric restructure's state migration.
terraform/terraform.tfstate.*.backup
terraform/*.tfplan
terraform/terraform.tfvars
# Per-workspace state (`terraform workspace new`) -- same sensitivity as the
# default state file above. Found missing during the fresh-project
# reproducibility test (2026-08-21), which introduced workspaces.
terraform/terraform.tfstate.d/
# Disposable, project-specific -var-file scratch files from running
# Notes/GCP Sandbox/Fresh Project Reproducibility Test.md -- real project
# IDs baked in, not meant to be reusable/committed. See that doc for the
# real, sanitized command/template.
terraform/new-project*.tfvars
