.venv/
__pycache__/
*.pyc
.env

# Terraform -- state can contain sensitive values and must never be committed
# (gcp-foundation-artiva commits its tfstate; deliberately not repeating that here).
# .terraform.lock.hcl is NOT ignored -- that one should be committed, it just pins provider versions.
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.backup
terraform/*.tfplan
